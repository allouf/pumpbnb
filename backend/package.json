{
  "name": "pumpbnb-backend",
  "version": "1.0.0",
  "description": "Backend API for PumpBNB - BNB Chain meme coin launchpad",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "npx -p prisma@5.22.0 -p @prisma/client@5.22.0 prisma generate && npx tsc",
    "build:fresh": "npx -p prisma@5.22.0 prisma generate && npx tsc && npx -p prisma@5.22.0 prisma migrate reset --force",
    "start": "npx -p prisma@5.22.0 prisma db push && node dist/server.js",
    "start:simple": "node dist/server.js",
    "start:migrate": "npx -p prisma@5.22.0 -p @prisma/client@5.22.0 prisma generate && npx tsc && npx -p prisma@5.22.0 prisma migrate deploy && node dist/server.js",
    "start:reset": "npx -p prisma@5.22.0 prisma migrate reset --force && node dist/server.js",
    "start:fresh": "npx -p prisma@5.22.0 prisma db push --force-reset && node dist/server.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "prisma:generate": "npx -p prisma@5.22.0 prisma generate",
    "prisma:migrate": "npx -p prisma@5.22.0 prisma migrate dev",
    "prisma:studio": "npx -p prisma@5.22.0 prisma studio",
    "index-token": "ts-node scripts/index-token.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "blockchain",
    "bnb",
    "defi",
    "tokens",
    "api"
  ],
  "author": "PumpBNB Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.1",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.20.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "prisma": "5.22.0",
    "socket.io": "^4.8.1",
    "typescript": "^5.9.3",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rate-limit-redis": "^4.2.3",
    "ts-node": "^10.9.2"
  },
  "types": "./dist/server.d.ts"
}
