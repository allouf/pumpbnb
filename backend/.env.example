# Server Configuration
NODE_ENV=development
PORT=3001
HOST=localhost

# Database URLs
DATABASE_URL="postgresql://user:password@localhost:5432/pumpbnb?schema=public"
MONGODB_URI="mongodb://localhost:27017/pumpbnb"
REDIS_URL="redis://localhost:6379"

# Blockchain Configuration
BSC_TESTNET_RPC="https://bsc-testnet-rpc.publicnode.com"
BSC_MAINNET_RPC="https://bsc-dataseed1.binance.org"
CHAIN_ID=97

# Contract Addresses (BSC Testnet) - Updated December 1, 2025 - Redeployed contracts
TOKEN_FACTORY_ADDRESS="0x535dD472F8A7B20B8c852A9fa7AFc1028D22E52D"
GRADUATION_MANAGER_ADDRESS="0x4b2feB661187641B1b637B5133c3E2e259B56b05"
PLATFORM_CONFIG_ADDRESS="0xD00F67880B41cdCa805419d56b3747cfe30CCdBA"
ASTER_TOKEN_ADDRESS="0x9C61208DAb099F9287E0104cbDd92bca507c1265"
SAMPLE_TOKEN_ADDRESS="0x1Fc9e9982A27Ea1762dB7385E031563d7a09fA78"

# IPFS Configuration
PINATA_API_KEY="your_pinata_api_key"
PINATA_SECRET_KEY="your_pinata_secret_key"
PINATA_JWT="your_pinata_jwt"

# JWT Configuration
JWT_SECRET="your_jwt_secret_change_in_production"
JWT_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# Logging
LOG_LEVEL="info"

# Redis Configuration (Token Page Features)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# WebSocket Configuration
WEBSOCKET_CORS_ORIGIN=http://localhost:3000
WEBSOCKET_PING_INTERVAL=25000
WEBSOCKET_PING_TIMEOUT=60000

# Session Configuration
SESSION_EXPIRY_HOURS=24
NONCE_EXPIRY_MINUTES=10

# Cache Configuration (Token Page)
CACHE_TTL_SECONDS=60
CACHE_TOKEN_TTL=300
CACHE_STATS_TTL=30
CACHE_TRADES_TTL=10
CACHE_HOLDERS_TTL=60
CACHE_COMMENTS_TTL=30

# Data Indexing
INDEXING_ENABLED=true
INDEXING_START_BLOCK=0
INDEXING_BATCH_SIZE=1000
INDEXING_INTERVAL_MS=3000

# OHLCV Aggregation
OHLCV_AGGREGATION_ENABLED=true
OHLCV_TIMEFRAMES=1m,5m,15m,1h,4h,1d
