// Prisma schema for PostgreSQL database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  id           String    @id @default(uuid())
  address      String    @unique
  name         String
  symbol       String
  description  String
  imageUrl     String
  creator      String
  totalSupply  String
  bondingCurve String
  createdAt    DateTime  @default(now())
  blockNumber  Int       @default(0)
  graduatedAt  DateTime?
  isGraduated  Boolean   @default(false)
  isNsfw       Boolean   @default(false)
  ipfsHash     String?
  website      String?
  twitter      String?
  telegram     String?
  discord      String?

  trades Trade[]
  stats  TokenStats?

  @@index([creator])
  @@index([createdAt])
  @@index([isGraduated])
  @@index([isNsfw])
  @@index([blockNumber])
  @@map("tokens")
}

model Trade {
  id           String   @id @default(uuid())
  tokenAddress String
  trader       String
  isBuy        Boolean
  amountIn     String
  amountOut    String
  fee          String
  timestamp    DateTime @default(now())
  txHash       String   @unique
  blockNumber  Int
  price        String? // Price at time of trade (nullable for old records)
  marketCap    String? // Market cap at time of trade
  asterAmount  String? // ASTER amount (for base pair) - nullable for old records
  tokenAmount  String? // Token amount - nullable for old records

  token Token @relation(fields: [tokenAddress], references: [address], onDelete: Cascade)

  @@index([tokenAddress])
  @@index([trader])
  @@index([timestamp])
  @@index([blockNumber])
  @@map("trades")
}

model TokenStats {
  id             String   @id @default(uuid())
  tokenAddress   String   @unique
  price          String   // Price in ASTER
  priceUsd       String   @default("0") // Price in USD
  marketCap      String   // Market cap in ASTER
  marketCapUsd   String   @default("0") // Market cap in USD
  volume24h      String   // Volume in ASTER
  volume24hUsd   String   @default("0") // Volume in USD
  trades24h      Int      @default(0)
  holders        Int      @default(0)
  liquidity      String
  liquidityUsd   String   @default("0") // Liquidity in USD
  priceChange24h String   @default("0")
  updatedAt      DateTime @updatedAt

  token Token @relation(fields: [tokenAddress], references: [address], onDelete: Cascade)

  @@index([volume24h])
  @@index([volume24hUsd])
  @@index([marketCap])
  @@index([marketCapUsd])
  @@index([updatedAt])
  @@map("token_stats")
}

model UserPortfolio {
  id              String   @id @default(uuid())
  userAddress     String
  tokenAddress    String
  balance         String
  averageBuyPrice String   @default("0")
  totalInvested   String   @default("0")
  updatedAt       DateTime @updatedAt

  @@unique([userAddress, tokenAddress])
  @@index([userAddress])
  @@index([tokenAddress])
  @@map("user_portfolios")
}

model Watchlist {
  id           String   @id @default(uuid())
  userAddress  String
  tokenAddress String
  addedAt      DateTime @default(now())

  @@unique([userAddress, tokenAddress])
  @@index([userAddress])
  @@map("watchlists")
}

model GraduationEvent {
  id              String   @id @default(uuid())
  tokenAddress    String   @unique
  asterCollected  String
  wbnbReceived    String
  lpTokensBurned  String
  pancakeSwapPair String
  timestamp       DateTime @default(now())
  txHash          String   @unique
  blockNumber     Int

  @@index([timestamp])
  @@index([blockNumber])
  @@map("graduation_events")
}

model PlatformStats {
  id                   String   @id @default(uuid())
  date                 DateTime @unique @default(now())
  totalTokensCreated   Int      @default(0)
  totalTokensGraduated Int      @default(0)
  totalVolume          String   @default("0")
  totalFees            String   @default("0")
  totalTrades          Int      @default(0)
  activeUsers          Int      @default(0)

  @@index([date])
  @@map("platform_stats")
}

model IndexerState {
  id               String   @id @default(uuid())
  lastIndexedBlock Int
  updatedAt        DateTime @updatedAt

  @@map("indexer_state")
}

// Token Page Features - New Models

model TokenHolder {
  id            String   @id @default(uuid())
  tokenAddress  String
  holderAddress String
  balance       String
  percentage    Float
  isCreator     Boolean  @default(false)
  firstTxAt     DateTime @default(now())
  lastTxAt      DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tokenAddress, holderAddress])
  @@index([tokenAddress])
  @@index([holderAddress])
  @@index([percentage])
  @@map("token_holders")
}

model Comment {
  id           String   @id @default(uuid())
  tokenAddress String
  userAddress  String
  content      String
  replyTo      String?
  likes        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tokenAddress])
  @@index([userAddress])
  @@index([createdAt])
  @@index([replyTo])
  @@map("comments")
}

model CommentLike {
  id          String   @id @default(uuid())
  commentId   String
  userAddress String
  createdAt   DateTime @default(now())

  @@unique([commentId, userAddress])
  @@index([commentId])
  @@index([userAddress])
  @@map("comment_likes")
}

model UserFavorite {
  id           String   @id @default(uuid())
  userAddress  String
  tokenAddress String
  timeframe    String // "1m", "5m", "15m", "1h", etc.
  createdAt    DateTime @default(now())

  @@unique([userAddress, tokenAddress, timeframe])
  @@index([userAddress])
  @@index([tokenAddress])
  @@map("user_favorites")
}

model OHLCVData {
  id           String   @id @default(uuid())
  tokenAddress String
  timeframe    String // "1m", "5m", "15m", "1h", "4h", "1d"
  timestamp    DateTime
  open         String
  high         String
  low          String
  close        String
  volume       String
  trades       Int      @default(0)

  @@unique([tokenAddress, timeframe, timestamp])
  @@index([tokenAddress])
  @@index([timeframe])
  @@index([timestamp])
  @@map("ohlcv_data")
}

model User {
  id                  String   @id @default(uuid())
  walletAddress       String   @unique
  username            String?  @unique
  bio                 String?
  profileImage        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lastUsernameChange  DateTime?
  followersCount      Int      @default(0)
  followingCount      Int      @default(0)
  createdTokensCount  Int      @default(0)

  @@index([walletAddress])
  @@index([username])
  @@map("users")
}

model UserFollow {
  id            String   @id @default(uuid())
  followerAddress String
  followingAddress String
  createdAt     DateTime @default(now())

  @@unique([followerAddress, followingAddress])
  @@index([followerAddress])
  @@index([followingAddress])
  @@map("user_follows")
}

model UserSession {
  id             String   @id @default(uuid())
  userAddress    String
  nonce          String   @unique
  signature      String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())

  @@index([userAddress])
  @@index([expiresAt])
  @@map("user_sessions")
}
