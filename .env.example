# Private Keys
# WARNING: Never commit your actual private key to version control
# Use a dedicated wallet for development/testing only
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# RPC URLs (optional - defaults are provided in hardhat.config.ts)
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_MAINNET_RPC=https://bsc-dataseed1.binance.org

# API Keys
BSCSCAN_API_KEY=your_bscscan_api_key_here
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Gas Reporter
REPORT_GAS=false

# Network Selection (for deployment scripts)
NETWORK=bscTestnet
